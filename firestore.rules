rules_version = '2';

// COACH — who may read/write what. Schema: docs/firestore.md.
//
// Open sign-up: signing in with Google proves an email; the allowlist
// maps that email to one account. Owner-made entries (console /
// scripts/migrate-to-firestore.js) are "invited" and share the owner's
// Gemini key. Anyone else creates their own entry on first sign-in
// (selfServe, accountId = their uid) and brings their own key. Setting
// blocked: true on an entry (console) turns that account off. The same guarantees
// the old GitHub merge gave (src/db/sync.js mergeBackups) hold here:
//   - a deleted session can never be recreated (deletion wins)
//   - a session / aiSettings write can't overwrite a newer copy
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email.lower(); }
    function entryPath() { return /databases/$(database)/documents/allowlist/$(email()); }
    function entry() { return get(entryPath()).data; }
    function allowed() {
      return signedIn() && exists(entryPath()) && entry().get('blocked', false) != true;
    }
    // owner-made entries only — self-serve accounts never see the shared key
    function invited() { return allowed() && entry().get('selfServe', false) != true; }
    function owns(acct) { return allowed() && entry().accountId == acct; }
    function isAdmin() { return allowed() && entry().get('admin', false) == true; }
    // Each account's data is private to its owner — the admin can't read
    // anyone's workouts, health data or chats (privacy policy), only the
    // allowlist (names), feedback sent to them, and subscription status.
    function canRead(acct) { return owns(acct); }
    function notNewer() {
      return resource == null
        || request.resource.data.get('updatedAt', 0) >= resource.data.get('updatedAt', 0);
    }

    match /allowlist/{mail} {
      allow read: if signedIn() && (mail == email() || isAdmin());
      // first sign-in: your own email → a fresh account named by your uid,
      // never admin; after that only the owner can change it
      allow create: if signedIn() && mail == email()
        && request.resource.data.keys().hasOnly(['accountId', 'name', 'admin', 'selfServe', 'createdAt'])
        && request.resource.data.accountId == request.auth.uid
        && request.resource.data.admin == false
        && request.resource.data.selfServe == true;
      allow update: if false;
      // Settings → Delete account removes your own entry last (a blocked
      // entry stays, so deleting can't be used to sign up again)
      allow delete: if signedIn() && mail == email() && resource.data.get('blocked', false) != true;
    }

    // shared Gemini key (one key for the invited accounts, changed in one place)
    match /config/shared {
      allow read: if invited();
      allow write: if isAdmin();
    }

    // COACH Pro status, written only by the server (functions/: the
    // RevenueCat webhook) — never by a client
    match /entitlements/{acct} {
      allow read: if owns(acct) || isAdmin();
      allow write: if false;
    }

    match /accounts/{acct} {
      allow read: if canRead(acct);
      // sign-up makes the account doc alongside the allowlist entry
      allow create: if signedIn() && acct == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'createdAt']);
      // name/backupMeta/migratedFrom are set by the migration; clients
      // only maintain the GitHub backup settings and their own Gemini key
      allow update: if owns(acct)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['github', 'geminiKey']);
      // account deletion (everything below is deleted first)
      allow delete: if owns(acct);

      match /sessions/{id} {
        allow read: if canRead(acct);
        allow create, update: if owns(acct) && notNewer()
          && !exists(/databases/$(database)/documents/accounts/$(acct)/deletedIds/$(id));
        allow delete: if owns(acct);
      }

      match /deletedIds/{id} {
        allow read: if canRead(acct);
        allow create, update: if owns(acct);
        allow delete: if owns(acct); // account deletion only — the apps never drop a marker
      }

      match /state/aiSettings {
        allow read: if canRead(acct);
        allow create, update: if owns(acct) && notNewer();
        allow delete: if owns(acct);
      }

      // health/{date}, events/{iso|type}, state/{today|weeklyReview|…}.
      // Rules OR together, so writes exclude state/aiSettings — or this
      // would bypass its newer-wins check above. Reads must NOT test the
      // document id: a whole-collection listener is only allowed when
      // the rule holds for every document without knowing which.
      match /{col}/{id} {
        allow read: if canRead(acct) && col in ['health', 'events', 'state'];
        allow write: if owns(acct) && col in ['health', 'events', 'state']
          && !(col == 'state' && id == 'aiSettings');
      }

      // feedback: written by the user, read by them and the admin
      match /feedback/{id} {
        allow create: if owns(acct);
        allow read: if owns(acct) || isAdmin();
        allow delete: if owns(acct); // account deletion
      }
    }
  }
}
